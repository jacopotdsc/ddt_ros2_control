<?xml version="1.0"?>
<!-- Sensor noise of the Gazebo bridge (usr_gazebo_ros2_control/GazeboBridge, read()): <param> of the
     <ros2_control><hardware> block, used by the ros2control macro when sensor_noise != 'none'.
     Values measured on the real TITA (bags 2026-10-22, debug_rl0 and experiment_00-09-49, robot at rest
     and moving; friction_test/scripts/sensor_noise_from_bags.py, friction_estimation.md):
       position quantized 1.92e-4 rad (15 bit), velocity quantized 1.05e-2 rad/s, effort steps 0.025 Nm
       (legs) / 0.0011 Nm (wheels), effort std 0.03-0.045 Nm (legs) / 0.01 (wheels) at rest, velocity
       0.04-0.08 rad/s high-frequency while moving, gyro std 0.004-0.0065 rad/s with bias up to 0.0035,
       accelerometer std 0.03-0.04 m/s2 (median of 1-s rest windows), orientation std ~6e-5 rad (AHRS output). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="sensor_noise_params">
    <param name="noise_q_quant">1.9175e-4</param>
    <param name="noise_dq_std_leg">0.03</param>
    <param name="noise_dq_std_wheel">0.05</param>
    <param name="noise_dq_quant">1.05e-2</param>
    <param name="noise_tau_std_leg">0.04</param>
    <param name="noise_tau_std_wheel">0.01</param>
    <param name="noise_tau_quant_leg">0.025</param>
    <param name="noise_tau_quant_wheel">0.0011</param>
    <param name="noise_gyro_std">0.005</param>
    <param name="noise_gyro_bias">0.004</param>
    <param name="noise_acc_std">0.04</param>
    <param name="noise_rpy_std">6e-5</param>
    <param name="noise_seed">1</param>
  </xacro:macro>
</robot>
