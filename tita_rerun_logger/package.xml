<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tita_rerun_logger</name>
  <version>0.2.0</version>
  <description>Records TITA debug data (ground truth, state filter, robot sensors, MPX, RL FSM) to Rerun.</description>
  <maintainer email="jacopotedeschi100@gmail.com">Jacopo Tedeschi</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- rerun-sdk is installed with pip (see README) -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
